DB_HOST=your-hostinger-mysql-host
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# Public community invite shared by every Discord CTA.
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/2XwuujbuNT

# Shared secret with the Discord bot, server-only. Generate a strong random value.
# It authorises application delivery and the server-side Discord roster sync.
# Also signs private booking links. Apply sql/008_discord_meetings.sql before
# setting WEBSITE_MEETINGS_CATEGORY_ID on the bot. No extra website secret needed.
WEBSITE_BOT_TOKEN=

# Render origin for xenondiscordbot. This is read only by Next.js on the server;
# it is never exposed in browser JavaScript.
DISCORD_BOT_URL=https://your-xenon-discord-bot.onrender.com

# Server-only key for the bot's public configuration API. Separate from WEBSITE_BOT_TOKEN.
INTERNAL_BOT_API_KEY=
